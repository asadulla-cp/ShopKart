PORT=8000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/shopkart
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Razorpay Test Mode — get from dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend origin (comma-separated for multiple)
# Set this to your Vercel URL on Render
CLIENT_ORIGIN=https://your-app.vercel.app
